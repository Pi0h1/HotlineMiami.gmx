          <argument>
            <kind>1</kind>
            <string>mapdir  = 0;
addx    = 0;
intro   = 0;
newsong = 1;

global.levels[20] = 1;
global.levels[21] = 1;
global.levels[22] = 1;

if (global.xbox == 1) {
    scrInitXboxButtons();
}
wait = 0;
scrFreeSurfaces();

a = 0;
level[a++]=sprTrainstation;
level[a++]=sprApartment1;
level[a++]=sprApartment2;
level[a++]=sprHouse1;
level[a++]=sprHouse5;
level[a++]=sprHouse2;
level[a++]=sprHotel;
level[a++]=sprBuilding;
level[a++]=sprHouse3;
level[a++]=sprSwatLevel;
level[a++]=sprHouse4;
level[a++]=sprOffice;
level[a++]=sprHospital;
level[a++]=sprPoliceHQ;
level[a++]=sprBossClub;
level[a++]=sprMansion;
level[a++]=sprNoodleShop;
level[a++]=sprArcade;
level[a++]=sprPhoneLevel;
level[a++]=sprBossClub2;
level[a++]=sprVenusLevel;
level[a++]=sprEurogamerLogo;
level[a++]=sprTitleCocaineCowboy;

a = 0;
title[a++]="THE METRO";
title[a++]="NO TALK";
title[a++]="OVERDOSE";
title[a++]="DECADENCE";
title[a++]="TENSION";
title[a++]="FULL HOUSE";
title[a++]="CLEAN HIT";
title[a++]="NEIGHBORS";
title[a++]="PUSH IT";
title[a++]="CRACKDOWN";
title[a++]="HOT&amp;HEAVY";
title[a++]="DEADLINE";
title[a++]="TRAUMA";
title[a++]="ASSAULT";
title[a++]="VENGEANCE";
title[a++]="SHOWDOWN";
title[a++]="SAFEHOUSE";
title[a++]="FUN&amp;GAMES";
title[a++]="PRANKCALL";
title[a++]="RESOLUTION";
title[a++]="HIGHBALL";
title[a++]="EXPOSED";
title[a++]="COCAINE COWBOY";

a = 0;
chapter[a++]="PRELUDE";
chapter[a++]="CHAPTER ONE";
chapter[a++]="CHAPTER TWO";
chapter[a++]="CHAPTER THREE";
chapter[a++]="CHAPTER FOUR";
chapter[a++]="CHAPTER FIVE";
chapter[a++]="CHAPTER SIX";
chapter[a++]="CHAPTER SEVEN";
chapter[a++]="CHAPTER EIGHT";
chapter[a++]="CHAPTER NINE";
chapter[a++]="CHAPTER TEN";
chapter[a++]="CHAPTER ELEVEN";
chapter[a++]="CHAPTER TWELVE";
chapter[a++]="CHAPTER THIRTEEN";
chapter[a++]="CHAPTER FOURTEEN";
chapter[a++]="FINAL CHAPTER";
chapter[a++]="CHAPTER SIXTEEN";
chapter[a++]="CHAPTER SEVENTEEN";
chapter[a++]="CHAPTER EIGHTEEN";
chapter[a++]="CHAPTER NINETEEN";
chapter[a++]="BONUS CHAPTER";
chapter[a++]="SPECIAL CHAPTER";
chapter[a++]="BETA CHAPTERS";

totalLevelCount_Jacket = 15;
totalLevelCount = a-1;

if (global.levels[totalLevelCount_Jacket] == 1) {
    levels = totalLevelCount // Reveal the real amount of levels once Jacket's campaign is complete. 
} else {
    levels = totalLevelCount_Jacket;
}

select      = 0;
repeats     = 16;
myrepeats   = 1;

x = (room_width/2);
y = (room_height*0.53);

i = 0;
repeat (20) {
    if (global.levels[i] == 0) {
        if (select == 0 &amp;&amp; global.levels[1] == 1) {
            select = i-1;
            title[i] = "LOCKED";
        }
    } i += 1;
}

restart = 0;
dir = 90;

fade = 0;
c_amount = 0;

global.i = 0;
repeat (10) {
    my_id = instance_create(x, y, objPalmTree);
    with (my_id) {
        repeat(global.i * 45) {
            amount *= 1.01;
        }
    }
    global.i+=1
}

alarm[0] = 45;
state = 0;

x_text       = 0;                                       // Initializes var. The value is affected in step event.
y_text       = 96 + 8;

x_textGrade  = 0;                                       // This value will be affected by x_text.
y_textGrade  = y_text + 15;

x_rankGrade  = 46;                                      // This value will be affected by x_text.
y_rankGrade  = y_textGrade - 8-4;

x_mask       = (sprite_get_width(sprMaskDropFront)/2) - 2;    // This value will be affected by x_text.
y_mask       = y_textGrade + 17;

x_puzzle     = x_mask + 11;                             // This value will be affected by x_text.
y_puzzle     = y_mask;

x_textIntro  = 0;                                       // This value will be affected by x_text.
y_textIntro  = y_text + 44;
y_textIntroOption  = y_text + 44 + 10;


</string>
